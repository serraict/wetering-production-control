# Base image for Wetering production control applications
# This image contains all common system dependencies and tools
# to reduce download times for individual applications

FROM python:3.12-slim-bookworm

# Set labels for the base image
LABEL maintainer="Marijn vander Zee <marijn@serraict.com>"
LABEL description="Base image for Wetering production control applications"
LABEL version="1.0"

RUN apt-get update && apt-get install --no-install-recommends -y \
    # Build dependencies
    git \
    build-essential \
    # Runtime tools
    curl \
    ca-certificates \
    gnupg2 \
    apt-transport-https \
    cron \
    # WeasyPrint dependencies
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    shared-mime-info \
    libgirepository1.0-dev \
    libglib2.0-0 \
    # Firebird client libraries
    libfbclient2 \
    # Additional common dependencies that might be needed
    pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/archives/*

RUN pip install --no-cache-dir uv setuptools_scm>=8.0.0

# Create common directories and files
RUN mkdir -p /app

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock README.md ./

# Create the virtual environment with exactly the locked production
# dependencies (no dev extras, not the project itself — the app image
# installs that). Installing from pyproject.toml alone ignored uv.lock and
# silently picked up newer releases (NiceGUI 3 while we tested on 2.19).
RUN uv sync --frozen --no-dev --no-install-project

# The .venv is now at /app/.venv with all dependencies installed

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
